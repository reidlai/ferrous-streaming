# syntax=docker/dockerfile:1.4
# Hardened Arroyo Stream Processor Container for FerrousCX
# Adheres strictly to Tier 2 DevSecOps standards (AD-13, NFR-13)

FROM ghcr.io/arroyosystems/arroyo:0.11.0 AS upstream

FROM debian:bookworm-slim

LABEL org.opencontainers.image.title="ferrous-streaming-arroyo" \
      org.opencontainers.image.description="Hardened Arroyo stream processor runtime for FerrousCX" \
      org.opencontainers.image.version="0.11.0" \
      org.opencontainers.image.vendor="FerrousCX" \
      org.opencontainers.image.licenses="Apache-2.0"

# Install minimal runtime dependencies (ca-certificates, curl) and clean apt cache
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# Create unprivileged non-root user and group (UID/GID 10001)
RUN groupadd -g 10001 arroyo && \
    useradd -u 10001 -g arroyo -s /sbin/nologin arroyo && \
    mkdir -p /data/arroyo /data/delta /etc/arroyo /usr/local/bin && \
    chown -R 10001:10001 /data/arroyo /data/delta /etc/arroyo

WORKDIR /data/arroyo

# Copy configuration
COPY --chown=10001:10001 config/arroyo.toml /etc/arroyo/arroyo.toml

# Copy binaries from upstream stage
COPY --from=upstream /usr/local/bin/arroyo /usr/local/bin/arroyo

# Switch to rootless runtime user
USER 10001:10001

# Volumes for persistent state and Delta Lake sink
VOLUME ["/data/arroyo", "/data/delta"]

# Expose Web UI / REST API port (5115)
EXPOSE 5115

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD ["curl", "-f", "http://localhost:5115/api/v1/ping"]

ENV ARROYO_API_PORT=5115 \
    ARROYO__CONFIG_DIR=/etc/arroyo

ENTRYPOINT ["/usr/local/bin/arroyo"]
CMD ["--config", "/etc/arroyo/arroyo.toml", "cluster"]
