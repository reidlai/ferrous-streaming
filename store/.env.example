# ==============================================================================
# Delta store environment configuration
# Copy this file to .env to override the defaults below.
# Maintenance (OPTIMIZE / VACUUM) needs no credentials: access is bounded by the
# container and the Delta volume, not by a token or an account.
# ==============================================================================

# Storage Configuration
LAKEHOUSE_DATA_DIR=data/delta
LAKEHOUSE_STORAGE_CONFIG=config/storage.toml
LAKEHOUSE_RETENTION_CONFIG=config/retention.toml

# Maintenance Parameters
DEFAULT_VACUUM_RETENTION_HOURS=168
DEFAULT_OPTIMIZE_TARGET_MB=128
