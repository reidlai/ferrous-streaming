# ==============================================================================
# ferrous-lakehouse Service Account Environment Configuration
# Copy this file to .env and replace placeholders with operational credentials.
# Adheres to DevSecOps Secret Zero Policy (Zero plaintext credentials in Git).
# ==============================================================================

# Kanidm M2M Service Account for Lakehouse Storage Governance (AD-16, FR-23)
LAKEHOUSE_SERVICE_ACCOUNT=svc_ferrous_lakehouse

# Service Account Bearer Token:
# - Option A (Live Kanidm): Obtain from Kanidm Web UI (https://localhost:8443)
#   under Service Accounts -> svc_ferrous_lakehouse -> API Tokens.
# - Option B (Local Offline Dev): Set to any string >=8 chars, e.g. "lakehouse_dev_token_2026".
LAKEHOUSE_SERVICE_TOKEN=<REPLACE_WITH_KANIDM_SERVICE_ACCOUNT_BEARER_TOKEN>

# Kanidm IdP Authentication Endpoint
KANIDM_URL=https://localhost:8443
KANIDM_CA_CERT=../ferrous-iam/config/certs/ca.pem

# Storage Configuration
LAKEHOUSE_DATA_DIR=data/delta
LAKEHOUSE_STORAGE_CONFIG=config/storage.toml
LAKEHOUSE_RETENTION_CONFIG=config/retention.toml

# Maintenance Parameters
DEFAULT_VACUUM_RETENTION_HOURS=168
DEFAULT_OPTIMIZE_TARGET_MB=128
