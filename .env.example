# FerrousCX Streaming Ingestion Stack - Environment Blueprint (Secret Zero)
# Copy this template to .env and configure secrets locally. Do NOT commit plaintext secrets to git.

# Apache Iggy Broker Networking
STREAMING_PORT=8090
STREAMING_TCP_PORT=8090
STREAMING_HTTP_PORT=3000
STREAMING_KAFKA_PORT=9092   # host loopback port of the Iggy-Kafka bridge (service bridge-host), not an Iggy server port
STREAMING_STORAGE_PATH=/data/iggy
IGGY_NODE_ADVERTISED_ADDRESS=localhost

# Broker Authentication & IAM Service Account (Story 3.2)
IGGY_AUTH_ENABLED=true
KANIDM_URL=https://localhost:8443
STREAMING_SERVICE_ACCOUNT=svc_ferrous_streaming
STREAMING_SERVICE_TOKEN=********
IGGY_HTTP_JWT_ENCODING_SECRET=********
IGGY_HTTP_JWT_DECODING_SECRET=********

# OpenTelemetry Telemetry Egress (FR-29)
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ferrous-streaming

# Iggy-Kafka bridge (AD-28). The Iggy user the bridge logs in as; create it with scripts/provision-bridge-user.py --apply
BRIDGE_IGGY_USERNAME=svc_kafka_bridge
BRIDGE_IGGY_PASSWORD=********
